# AI Image Trust Scanner local defaults.
# Copy to .env for local overrides. Do not commit real secrets.

# Default open-source mode is CPU-safe and does not load Hugging Face/Torch models.
DETECTOR_RUNTIME_MODE=stub
DETECTOR_WARMUP_ON_STARTUP=false
DETECTOR_ALLOW_COLD_MODEL_LOAD=false
OPEN_SOURCE_DETECTOR_ENABLED=false
HF_LOCAL_FILES_ONLY=true

# Local server settings used by scripts/run_local_dashboard.py.
MINERVA_HOST=127.0.0.1
MINERVA_PORT=8000

# Local runtime output paths. These are ignored by git.
MINERVA_UPLOAD_DIR=.tmp/api_uploads
MINERVA_API_REPORT_DIR=.tmp/api_reports
MINERVA_API_HISTORY_DIR=.tmp/api_history
MINERVA_C2PA_MANIFEST_DIR=.tmp/c2pa_manifests
MINERVA_REPORT_DB_PATH=.tmp/reports.sqlite3
MINERVA_HTML_REPORT_DIR=.tmp/html_reports
MINERVA_RUNTIME_IMAGE_DIR=.tmp/runtime_images
MINERVA_AUDIT_LOG_PATH=.tmp/audit_events.jsonl

# Optional local-only API key. Leave unset for personal local use.
# MINERVA_API_KEY=replace-with-a-local-random-token

# Optional model mode. Requires requirements-open-source.txt and locally available weights.
# DETECTOR_RUNTIME_MODE=local_hf
# DETECTOR_WARMUP_ON_STARTUP=true
# SMOGY_PEFT_ADAPTER=/absolute/path/to/ft_smogy_lora_v2
